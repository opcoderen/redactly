# Cloudflare Workers 静态资源会读取本文件并附加响应头，
# 与 docker/nginx.conf 中的安全头保持一致
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

/vendor/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=604800
